# Optional AI assistant (mobile app works without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Required for production database connectivity
DATABASE_URL=postgresql://user:password@localhost:5432/talegaon_fresh

# Required for production distributed rate limiting
REDIS_URL=redis://localhost:6379

# Startup migration mode. Set false when migrations run as a separate release job.
RUN_MIGRATIONS=true

# Firebase Cloud Messaging (FCM) for push notifications
# Path to Firebase service account JSON key file (downloaded from Firebase Console)
# If not set, FCM notifications will be disabled but app continues to work
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/app/firebase-service-account.json

# Deferred integrations: not required for mobile-only production
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
SELLER_WHATSAPP_NUMBER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Required for protected admin APIs and customer JWTs
ADMIN_API_TOKEN=
JWT_SECRET=replace-with-a-unique-secret-at-least-32-characters

ENVIRONMENT=development
PORT=8000
MIN_ORDER_VALUE=199

# Comma-separated browser origins for CORS.
# In production, use explicit HTTPS origins only; leave empty for mobile-only deployments.
CORS_ALLOWED_ORIGINS=

# Production OTP delivery via MSG91. Keep the auth key secret.
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=

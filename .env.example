# Optional AI assistant (mobile app works without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Required for production database connectivity
DATABASE_URL=postgresql://user:password@localhost:5432/talegaon_fresh

# Required for production distributed rate limiting
REDIS_URL=redis://localhost:6379

# Startup migration mode. Set false when migrations run as a separate release job.
RUN_MIGRATIONS=true

# Firebase Cloud Messaging (FCM) for push notifications
# Preferred: store the replacement service-account JSON as a Render secret env var.
# Never commit the JSON or paste it into chat. Revoke any previously exposed key in Google Cloud IAM.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional alternative: mount a newly generated key as a Render Secret File.
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/etc/secrets/firebase-service-account.json
# Optional for workloads with Google Application Default Credentials.
FIREBASE_USE_APPLICATION_DEFAULT_CREDENTIALS=false
# Set to 300 by default; tune only if the managed PostgreSQL provider requires it.
DB_POOL_RECYCLE_SECONDS=300

# Deferred integrations: not required for mobile-only production
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
SELLER_WHATSAPP_NUMBER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Required for protected admin APIs and customer JWTs
ADMIN_API_TOKEN=
JWT_SECRET=replace-with-a-unique-secret-at-least-32-characters

ENVIRONMENT=development
PORT=8000
MIN_ORDER_VALUE=199

# Comma-separated browser origins for CORS.
# In production, use explicit HTTPS origins only; leave empty for mobile-only deployments.
CORS_ALLOWED_ORIGINS=

# Production OTP delivery via MSG91. Keep the auth key secret.
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
# Optional read-only customer MCP (no OpenAI key needed).
# Keep disabled until a trusted backend client is configured.
MCP_ENABLED=false
# Exact backend hostname in production, without https:// or path.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*

# New-order admin email (STARTTLS SMTP; configure secrets only in Render)
ORDER_EMAIL_SMTP_HOST=smtp.gmail.com
ORDER_EMAIL_SMTP_PORT=587
ORDER_EMAIL_FROM=
ORDER_EMAIL_TO=
ORDER_EMAIL_USERNAME=
ORDER_EMAIL_PASSWORD=

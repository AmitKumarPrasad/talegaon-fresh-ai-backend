# Optional AI assistant (mobile app works without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Required for production database connectivity
DATABASE_URL=postgresql://user:password@localhost:5432/talegaon_fresh

# Deferred integrations: not required for mobile-only production
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
SELLER_WHATSAPP_NUMBER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Required for protected admin APIs and customer JWTs
ADMIN_API_TOKEN=
JWT_SECRET=replace-with-a-unique-secret-at-least-32-characters

ENVIRONMENT=development
PORT=8000
MIN_ORDER_VALUE=199

# Comma-separated list of allowed browser origins for CORS. Defaults to "*" (all origins).
CORS_ALLOWED_ORIGINS=*

# OTP SMS delivery via the open-source android-sms-gateway (https://github.com/capcom6/android-sms-gateway).
# Install the app on an Android phone with a SIM, register a Cloud Server account in it, and use those credentials here.
SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1/message
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
